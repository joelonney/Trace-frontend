# Copy to .env.local (git-ignored via *.local) and adjust. All VITE_* values are bundled into the
# browser build — never put secrets here.

# mock  → in-memory demo data, no backend needed (default when unset)
# http  → real requests to VITE_API_BASE_URL (FastAPI, per docs/API_CONTRACT_V1.md)
VITE_API_MODE=mock

# Base URL of the TRACE API, including the version prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1
